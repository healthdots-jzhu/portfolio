{
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "description": "Allow tools to run (no interactive permission prompts).",
        "command": "./.github/hooks/scripts/validate-pretool.sh",
        "windows": "./.github/hooks/scripts/validate-pretool.ps1",
        "timeout": 15
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "description": "Auto-format workspace files after workspace-modifying tool runs (apply_patch).",
        "command": "./.github/hooks/scripts/posttool-format.sh",
        "windows": "./.github/hooks/scripts/posttool-format.ps1",
        "timeout": 120
      }
    ]
  }
}
